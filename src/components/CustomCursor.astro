---
---
<div id="hud-cursor" class="pointer-events-none fixed inset-0 z-50 overflow-hidden" aria-hidden="true">
  <!-- HUD Reticle: Precision Center Dot + Concentric Outer Ring -->
  <div id="cursor-reticle" class="pointer-events-none opacity-0">
    <!-- Concentric Outer Ring (32px) -->
    <div id="cursor-ring" class="w-8 h-8 rounded-full border border-[var(--accent-blue)]/60 flex items-center justify-center transition-transform duration-150 ease-out">
      <!-- Precision Solid Center Dot (Always dead-center) -->
      <div id="cursor-dot" class="w-1.5 h-1.5 rounded-full bg-[var(--accent-blue)]"></div>
    </div>
  </div>

  <!-- 4 Corner Targets [ ] for hovered interactive items -->
  <div id="cursor-target" class="fixed pointer-events-none transition-all duration-150 opacity-0">
    <span class="corner corner-tl absolute top-0 left-0 w-2.5 h-2.5 border-t-2 border-l-2 border-[var(--accent-orange)] -translate-x-1 -translate-y-1"></span>
    <span class="corner corner-tr absolute top-0 right-0 w-2.5 h-2.5 border-t-2 border-r-2 border-[var(--accent-orange)] translate-x-1 -translate-y-1"></span>
    <span class="corner corner-bl absolute bottom-0 left-0 w-2.5 h-2.5 border-b-2 border-l-2 border-[var(--accent-orange)] -translate-x-1 translate-y-1"></span>
    <span class="corner corner-br absolute bottom-0 right-0 w-2.5 h-2.5 border-b-2 border-r-2 border-[var(--accent-orange)] translate-x-1 translate-y-1"></span>
  </div>
</div>

<style>
  #hud-cursor {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    #hud-cursor {
      display: block;
    }
  }

  #cursor-reticle {
    position: fixed;
    top: 0;
    left: 0;
    width: 32px;
    height: 32px;
    margin-top: -16px;
    margin-left: -16px;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s ease;
    will-change: transform;
  }
</style>

<script>
  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    const reticle = document.getElementById('cursor-reticle');
    const ring = document.getElementById('cursor-ring');
    const target = document.getElementById('cursor-target');

    let mouseX = -100, mouseY = -100;
    let isVisible = false;
    let isHovered = false;

    window.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;

      if (!isVisible && reticle) {
        reticle.style.opacity = '1';
        isVisible = true;
      }

      if (reticle) {
        reticle.style.transform = `translate3d(${mouseX}px, ${mouseY}px, 0)`;
      }
    });

    window.addEventListener('mousedown', () => {
      if (ring) {
        ring.style.transform = 'scale(0.85)';
      }
    });

    window.addEventListener('mouseup', () => {
      if (ring) {
        ring.style.transform = isHovered ? 'scale(1.25)' : 'scale(1)';
      }
    });

    document.addEventListener('mouseleave', () => {
      if (reticle) reticle.style.opacity = '0';
      if (target) target.style.opacity = '0';
      isVisible = false;
    });

    window.addEventListener('scroll', () => {
      if (target) target.style.opacity = '0';
    }, { passive: true });

    // Magnetic target locking on interactive elements
    const lockables = 'a, button, input, .hud-card, .interactive-target, [role="button"]';
    document.addEventListener('mouseover', (e) => {
      const el = (e.target as HTMLElement)?.closest(lockables) as HTMLElement | null;
      const related = (e.relatedTarget as HTMLElement | null)?.closest(lockables) as HTMLElement | null;
      if (el && el !== related) {
        isHovered = true;
        if (ring) {
          ring.style.transform = 'scale(1.25)';
          ring.style.borderColor = 'var(--accent-blue)';
        }
        if (target) {
          const rect = el.getBoundingClientRect();
          target.style.top = `${rect.top}px`;
          target.style.left = `${rect.left}px`;
          target.style.width = `${rect.width}px`;
          target.style.height = `${rect.height}px`;
          target.style.opacity = '1';
        }
        window.dispatchEvent(new CustomEvent('hud-mode-change', { detail: 'HOVER' }));
      }
    });

    document.addEventListener('mouseout', (e) => {
      const el = (e.target as HTMLElement)?.closest(lockables) as HTMLElement | null;
      const related = (e.relatedTarget as HTMLElement | null)?.closest(lockables) as HTMLElement | null;
      if (el && el !== related) {
        isHovered = false;
        if (ring) {
          ring.style.transform = 'scale(1)';
          ring.style.borderColor = '';
        }
        if (target) {
          target.style.opacity = '0';
        }
        window.dispatchEvent(new CustomEvent('hud-mode-change', { detail: 'NORMAL' }));
      }
    });
  }
</script>
